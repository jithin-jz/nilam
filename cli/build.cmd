@echo off
rem Builds the `nilam` command - version check and update - with the in-box
rem .NET Framework compiler. No SDK, no NuGet - same approach, and the same
rem quoting rules, as ..\build.cmd.
rem
rem It goes to bin\cli\nilam.exe, not bin\: the widget app is bin\Nilam.exe,
rem and Windows file names are not case-sensitive, so the two cannot share a
rem folder. bin\cli is the folder the installer puts on PATH, which makes
rem `nilam` in a terminal the command-line tool.

setlocal
set "FW=%SystemRoot%\Microsoft.NET\Framework\v4.0.30319"
set "CSC=%FW%\csc.exe"
set "HERE=%~dp0"

if not exist "%CSC%" goto :nocompiler
if not exist "%HERE%..\bin" mkdir "%HERE%..\bin"
if not exist "%HERE%..\bin\obj" mkdir "%HERE%..\bin\obj"
if not exist "%HERE%..\bin\cli" mkdir "%HERE%..\bin\cli"

set "DWVER="
set /p DWVER=<"%HERE%..\VERSION"
if "%DWVER%"=="" goto :noversion

set "GEN=%HERE%..\bin\obj\CliInfo.g.cs"
> "%GEN%" echo // Generated by cli\build.cmd from VERSION. Do not edit.
>>"%GEN%" echo [assembly: System.Reflection.AssemblyTitle("nilam - Nilam command-line tool")]
>>"%GEN%" echo [assembly: System.Reflection.AssemblyProduct("Nilam")]
>>"%GEN%" echo [assembly: System.Reflection.AssemblyCompany("jithin-jz")]
>>"%GEN%" echo [assembly: System.Reflection.AssemblyVersion("%DWVER%.0")]
>>"%GEN%" echo [assembly: System.Reflection.AssemblyFileVersion("%DWVER%.0")]
>>"%GEN%" echo [assembly: System.Reflection.AssemblyInformationalVersion("%DWVER%")]

rem /noconfig: see ..\build.cmd for why csc.rsp must be skipped.
rem SemVer.cs is shared with the widget exe so both compare versions one way.
"%CSC%" /nologo /noconfig /target:exe /platform:x86 /optimize+ /warn:4 ^
 /out:"%HERE%..\bin\cli\nilam.exe" ^
 /reference:"%FW%\mscorlib.dll" ^
 /reference:"%FW%\System.dll" ^
 "%HERE%Nilam.cs" "%HERE%..\src\SemVer.cs" "%GEN%"

if errorlevel 1 goto :failed
echo BUILD OK
exit /b 0

:failed
echo BUILD FAILED
exit /b 1

:nocompiler
echo The .NET Framework 4.x compiler was not found at "%CSC%".
exit /b 1

:noversion
echo The VERSION file is missing or empty.
exit /b 1
