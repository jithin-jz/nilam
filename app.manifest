<?xml version="1.0" encoding="utf-8"?>
<!--
  Embedded into Nilam.exe by build.cmd (/win32manifest).

  dpiAware is "true" - system DPI aware - on purpose. That is what WPF already
  selects for itself; stating it keeps the behaviour from depending on a
  default. Per-monitor awareness would make the cards sharp on a second monitor
  with a different scale, but it also changes the units Window.Left and
  Window.Top are measured in, which the saved layout depends on. It needs a
  mixed-DPI setup to test before it is switched on.
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="Nilam"/>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
    </windowsSettings>
  </application>
</assembly>
