@echo off
rem Builds Nilam.exe with the in-box .NET Framework compiler.
rem No SDK or NuGet packages required - every reference below ships with Windows.
rem
rem   build.cmd          bin\Nilam.exe
rem   build.cmd tests    bin\Tests.exe - the same sources plus tests\*.cs
rem
rem Two rules keep this working from any folder:
rem   - every `set` uses the quoted form, set "NAME=value", and every path is
rem     used inside quotes, so an "&" in the path (C:\Users\R&D\...) is never
rem     read as a command separator;
rem   - no path is expanded inside a parenthesised block, where the ")" of
rem     "Program Files (x86)" would close the block. Hence the gotos.

setlocal
rem 32-bit build: measured 12 MB lower private bytes than x64 for identical
rem behaviour, because pointers and the NGEN images are half the size.
set "FW=%SystemRoot%\Microsoft.NET\Framework\v4.0.30319"
set "CSC=%FW%\csc.exe"
set "GAC=%SystemRoot%\Microsoft.NET\assembly"
set "ROOT=%~dp0"

rem WinRT: reference the individual winmd files in System32. The unified
rem Windows.WinMD facade under Windows Kits is too old on many machines to
rem contain Windows.Media.Control, and System.Runtime.WindowsRuntime is
rem deliberately not referenced because its await/stream extensions bind to
rem that unified identity. WinRtAsync.cs covers what those extensions would
rem have provided.
set "WINMD=%SystemRoot%\System32\WinMetadata"

if not exist "%CSC%" goto :nocompiler

rem ---- version -------------------------------------------------------------
rem VERSION is the single source of the release number. It is stamped into the
rem exe here, so Task Manager, Settings > Apps and the app's own settings
rem window all report the same thing `nilam version` does. Numbers and dots
rem only: it becomes an AssemblyVersion.
set "DWVER="
set /p DWVER=<"%ROOT%VERSION"
if "%DWVER%"=="" goto :noversion

if not exist "%ROOT%bin" mkdir "%ROOT%bin"
if not exist "%ROOT%bin\obj" mkdir "%ROOT%bin\obj"
set "GEN=%ROOT%bin\obj\AssemblyInfo.g.cs"
> "%GEN%" echo // Generated by build.cmd from VERSION. Do not edit.
>>"%GEN%" echo [assembly: System.Reflection.AssemblyTitle("Nilam")]
>>"%GEN%" echo [assembly: System.Reflection.AssemblyProduct("Nilam")]
>>"%GEN%" echo [assembly: System.Reflection.AssemblyDescription("Desktop widgets for Windows")]
>>"%GEN%" echo [assembly: System.Reflection.AssemblyCompany("jithin-jz")]
>>"%GEN%" echo [assembly: System.Reflection.AssemblyCopyright("Copyright (c) 2026 jithin-jz. MIT licence.")]
>>"%GEN%" echo [assembly: System.Reflection.AssemblyVersion("%DWVER%.0")]
>>"%GEN%" echo [assembly: System.Reflection.AssemblyFileVersion("%DWVER%.0")]
>>"%GEN%" echo [assembly: System.Reflection.AssemblyInformationalVersion("%DWVER%")]

rem ---- compiler options ----------------------------------------------------
rem Written to a response file rather than passed on the command line, so the
rem options that differ between the two targets need no variables holding
rem quoted paths.
set "RSP=%ROOT%bin\obj\build.rsp"
> "%RSP%" echo /nologo
>>"%RSP%" echo /platform:x86
>>"%RSP%" echo /optimize+
>>"%RSP%" echo /warn:4

if /i "%~1"=="tests" goto :tests
>>"%RSP%" echo /target:winexe
>>"%RSP%" echo /out:"%ROOT%bin\Nilam.exe"
>>"%RSP%" echo /win32icon:"%ROOT%assets\app.ico"
>>"%RSP%" echo /win32manifest:"%ROOT%app.manifest"
goto :references

:tests
rem The tests are compiled into one exe together with the app's own sources,
rem so they can reach internal types without InternalsVisibleTo. /main picks
rem the test runner's entry point over the app's.
>>"%RSP%" echo /target:exe
>>"%RSP%" echo /out:"%ROOT%bin\Tests.exe"
>>"%RSP%" echo /main:Nilam.Tests.TestRunner
>>"%RSP%" echo "%ROOT%tests\*.cs"

:references
>>"%RSP%" echo /reference:"%FW%\mscorlib.dll"
>>"%RSP%" echo /reference:"%FW%\System.dll"
>>"%RSP%" echo /reference:"%FW%\System.Core.dll"
>>"%RSP%" echo /reference:"%FW%\System.Xml.dll"
>>"%RSP%" echo /reference:"%FW%\System.Web.Extensions.dll"
>>"%RSP%" echo /reference:"%GAC%\GAC_MSIL\PresentationFramework\v4.0_4.0.0.0__31bf3856ad364e35\PresentationFramework.dll"
>>"%RSP%" echo /reference:"%GAC%\GAC_32\PresentationCore\v4.0_4.0.0.0__31bf3856ad364e35\PresentationCore.dll"
>>"%RSP%" echo /reference:"%GAC%\GAC_MSIL\WindowsBase\v4.0_4.0.0.0__31bf3856ad364e35\WindowsBase.dll"
>>"%RSP%" echo /reference:"%GAC%\GAC_MSIL\System.Xaml\v4.0_4.0.0.0__b77a5c561934e089\System.Xaml.dll"
>>"%RSP%" echo /reference:"%GAC%\GAC_MSIL\System.Runtime\v4.0_4.0.0.0__b03f5f7f11d50a3a\System.Runtime.dll"
>>"%RSP%" echo /reference:"%WINMD%\Windows.Foundation.winmd"
>>"%RSP%" echo /reference:"%WINMD%\Windows.Media.winmd"
>>"%RSP%" echo /reference:"%WINMD%\Windows.Storage.winmd"
>>"%RSP%" echo "%ROOT%src\*.cs"
>>"%RSP%" echo "%GEN%"

rem /noconfig is required, not an optimisation, and has to be on the command
rem line: the compiler rejects it inside a response file.
rem
rem Without it the compiler applies csc.rsp, which auto-references about forty
rem legacy Framework assemblies. Since the February 2026 servicing update at
rem least one of those drags in the .NET Standard shim
rem System.ComponentModel.Primitives.dll, and that assembly and System.dll now
rem hold type forwarders pointing at each other. The compiler rejects the cycle
rem (CS0731) and then cannot resolve ISupportInitialize, which every WPF Window
rem implements - so the build fails on the first line that mentions a Window.
rem Referencing the shim explicitly does not help; it is one half of the cycle.
rem
rem /noconfig skips csc.rsp, so the curated list above is the complete reference
rem set. Anything added to it must be a real assembly, never one of the ~106
rem small netstandard shims sitting in the Framework directory.
"%CSC%" /noconfig @"%RSP%"

if errorlevel 1 goto :failed
echo BUILD OK
exit /b 0

:failed
echo BUILD FAILED
exit /b 1

:nocompiler
echo The .NET Framework 4.x compiler was not found at "%CSC%".
echo Enable .NET Framework 4.8 in "Turn Windows features on or off" and try again.
exit /b 1

:noversion
echo The VERSION file is missing or empty.
exit /b 1
